// ─── TOGGLE SETTINGS ───
function toggleSetting(btn){
  const on=btn.style.background==='var(--b500)'||btn.style.background.includes('16, 147, 217');
  btn.style.background=on?'var(--b100)':'var(--b500)';
  const thumb=btn.querySelector('.tthumb');
  if(thumb)thumb.style.left=on?'3px':'19px';
}

