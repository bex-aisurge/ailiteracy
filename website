function answerQ(idx){
  if(qs.sel!==null)return;
  qs.sel=idx;render();
  setTimeout(()=>{
    const correct=idx===QUIZ[qs.step].c;
    const ns=qs.score+(correct?1:0);
    if(qs.step+1>=QUIZ.length)qs={step:qs.step+1,sel:null,score:ns,done:true};
    else qs={step:qs.step+1,sel:null,score:ns,done:false};
    render();
  },800);
}

