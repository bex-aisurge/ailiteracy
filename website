<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI Surge — AI Literacy for Schools</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --b50:#EFF8FF;--b100:#DBEFFE;--b200:#BAE3FD;--b300:#7DCAFB;--b400:#39AEF5;
  --b500:#1093D9;--b600:#0474B5;--b700:#055D92;--b800:#094E79;--b900:#0D3F63;
  --navy:#0A2540;--white:#fff;--slate:#F4F8FC;--slate2:#E1EAF4;
  --text:#0A2540;--muted:#5C7EA8;--success:#10B981;--warn:#F59E0B;--danger:#EF4444;
  --shadow:0 1px 3px rgba(10,37,64,.06),0 4px 16px rgba(10,37,64,.06);
  --shadowmd:0 4px 24px rgba(10,37,64,.14)
}
body{font-family:'Poppins',sans-serif;background:var(--b50);color:var(--text);font-size:14px;overflow-x:hidden}
.screen{display:none;min-height:100vh}.screen.active{display:block}
#app{min-height:unset;height:100vh;overflow:hidden}#app.active{display:flex!important}

/* BUTTONS */
.btn{display:inline-flex;align-items:center;gap:6px;padding:10px 20px;border-radius:10px;border:none;font-family:'Poppins',sans-serif;font-weight:600;font-size:13px;cursor:pointer;transition:all .2s;letter-spacing:.01em}
.btn-primary{background:var(--b500);color:#fff}.btn-primary:hover{background:var(--b600);transform:translateY(-1px)}
.btn-secondary{background:var(--b100);color:var(--b700)}.btn-secondary:hover{background:var(--b200)}
.btn-ghost{background:transparent;color:var(--b500);border:2px solid var(--b500)}.btn-ghost:hover{background:var(--b500);color:#fff}
.btn-ghostw{background:transparent;color:#fff;border:2px solid rgba(255,255,255,.45)}.btn-ghostw:hover{background:rgba(255,255,255,.12)}
.btn-danger{background:var(--danger);color:#fff}
.btn-sm{padding:7px 14px;font-size:12px;border-radius:8px}
.btn-full{width:100%;justify-content:center}

/* CARD */
.card{background:#fff;border-radius:14px;padding:20px;box-shadow:var(--shadow);border:1px solid var(--b100)}

/* BADGE */
.badge{display:inline-flex;align-items:center;padding:3px 10px;border-radius:99px;font-size:10px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;white-space:nowrap}

/* PROGRESS */
.pbw{background:var(--b100);border-radius:99px;overflow:hidden}
.pbf{height:100%;border-radius:99px;transition:width .5s ease}

/* ── LANDING ── */
#landing{background:#fff}
.nav{background:var(--navy);padding:0 48px;display:flex;align-items:center;justify-content:space-between;height:70px;position:sticky;top:0;z-index:100}
.nav-logo{display:flex;align-items:center;text-decoration:none}
.nav-logo img{height:40px;width:auto}
.nav-links{display:flex;gap:32px;align-items:center}
.nav-link{color:rgba(255,255,255,.65);font-size:14px;font-weight:500;cursor:pointer;text-decoration:none;transition:color .2s}
.nav-link:hover{color:#fff}

.hero{background:linear-gradient(135deg,var(--navy) 0%,#0D3F63 55%,#094E79 100%);padding:100px 48px 80px;text-align:center;position:relative;overflow:hidden}
.hero-dots{position:absolute;inset:0;opacity:.04;background-image:radial-gradient(circle at 2px 2px,white 1px,transparent 0);background-size:40px 40px;pointer-events:none}
.hero-chip{display:inline-block;background:rgba(16,147,217,.25);border:1px solid rgba(16,147,217,.5);border-radius:99px;padding:6px 20px;margin-bottom:24px}
.hero-chip span{color:var(--b300);font-size:12px;font-weight:700;letter-spacing:.07em}
.hero h1{color:#fff;font-size:54px;line-height:1.1;margin:0 auto 22px;max-width:800px;font-weight:800;letter-spacing:-.02em}
.hero h1 em{color:var(--b300);font-style:normal}
.hero p{color:rgba(255,255,255,.65);font-size:19px;max-width:560px;margin:0 auto 40px;line-height:1.7;font-weight:400}
.hero-btns{display:flex;gap:14px;justify-content:center}
.hero-stats{margin-top:52px;display:flex;justify-content:center;gap:60px}
.hstat-val{color:#fff;font-size:28px;font-weight:800}
.hstat-lbl{color:rgba(255,255,255,.45);font-size:12px;margin-top:2px;font-weight:500}

.topics-sec{padding:52px 48px;background:var(--b50);text-align:center}
.topics-lbl{color:var(--muted);font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;margin-bottom:20px}
.topics-pills{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;max-width:720px;margin:0 auto}
.pill{background:#fff;border:1px solid var(--b200);border-radius:99px;padding:8px 20px;font-size:13px;font-weight:600;color:var(--navy);transition:all .2s}
.pill:hover{border-color:var(--b500);color:var(--b600)}

.features-sec{padding:80px 48px;max-width:1100px;margin:0 auto}
.features-sec h2{font-size:38px;font-weight:800;color:var(--navy);text-align:center;margin-bottom:10px}
.feat-sub{color:var(--muted);font-size:17px;text-align:center;margin-bottom:48px}
.feat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.feat-card{background:#fff;border-radius:16px;padding:28px;box-shadow:var(--shadow);border:1px solid var(--b100);transition:all .2s}
.feat-card:hover{transform:translateY(-3px);box-shadow:var(--shadowmd)}
.feat-icon{font-size:30px;margin-bottom:14px}
.feat-title{font-size:15px;font-weight:700;color:var(--navy);margin-bottom:7px}
.feat-desc{font-size:13px;color:var(--muted);line-height:1.7}

.roles-sec{background:var(--b50);padding:80px 48px}
.roles-sec h2{font-size:36px;font-weight:800;color:var(--navy);text-align:center;margin-bottom:44px}
.roles-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;max-width:1100px;margin:0 auto}
.role-card{background:#fff;border-radius:16px;padding:26px;box-shadow:var(--shadow);border:2px solid transparent;text-align:center;transition:all .2s}
.role-card:hover{border-color:var(--b300);transform:translateY(-2px)}
.role-icon{font-size:34px;margin-bottom:12px}
.role-title{font-size:14px;font-weight:700;color:var(--navy);margin-bottom:7px}
.role-desc{font-size:12px;color:var(--muted);line-height:1.6}

.cta-sec{background:linear-gradient(135deg,var(--navy),#0D3F63);padding:80px 48px;text-align:center}
.cta-sec h2{color:#fff;font-size:36px;font-weight:800;margin-bottom:14px}
.cta-sec p{color:rgba(255,255,255,.55);font-size:17px;margin-bottom:34px}

/* ── LOGIN ── */
#login{background:linear-gradient(135deg,var(--navy),#0D3F63);display:flex;align-items:center;justify-content:center;padding:20px}
.login-wrap{width:440px}
.login-hdr{text-align:center;margin-bottom:26px}
.login-hdr img{height:54px;width:auto;margin-bottom:12px;filter:brightness(0) invert(1)}
.login-hdr p{color:rgba(255,255,255,.55);font-size:13px;margin-top:6px}
.login-card{background:#fff;border-radius:18px;padding:34px;box-shadow:0 24px 60px rgba(0,0,0,.35)}
.role-sel{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:20px}
.rsel-btn{padding:10px 4px;border-radius:9px;border:2px solid var(--b100);background:transparent;color:var(--muted);font-size:11px;font-weight:700;cursor:pointer;transition:all .2s;font-family:'Poppins',sans-serif}
.rsel-btn:hover{border-color:var(--b300);color:var(--b500)}
.rsel-btn.active{border-color:var(--b500);background:var(--b50);color:var(--b600)}
.flabel{font-size:11px;font-weight:700;color:var(--muted);letter-spacing:.06em;text-transform:uppercase;display:block;margin-bottom:6px}
.finput{width:100%;padding:12px 14px;border-radius:9px;border:1.5px solid var(--b100);font-size:14px;font-family:'Poppins',sans-serif;outline:none;transition:border-color .2s;color:var(--navy)}
.finput:focus{border-color:var(--b400)}
.fgroup{margin-bottom:16px}
.login-foot{text-align:center;margin-top:14px;font-size:12px;color:var(--muted)}
.login-foot a{color:var(--b500);font-weight:600;text-decoration:none;cursor:pointer}

/* ── APP ── */
.sidebar{width:235px;background:var(--navy);display:flex;flex-direction:column;flex-shrink:0;height:100vh}
.sb-hdr{padding:20px 16px;border-bottom:1px solid rgba(255,255,255,.08)}
.sb-logo{margin-bottom:14px}
.sb-logo img{height:34px;width:auto;filter:brightness(0) invert(1)}
.sb-user{border-radius:9px;padding:9px 11px}
.sb-name{color:#fff;font-size:12px;font-weight:700}
.sb-role{font-size:10px;font-weight:600}
.sb-nav{flex:1;padding:12px 10px;overflow-y:auto}
.nitem{display:flex;align-items:center;gap:10px;width:100%;padding:10px 11px;border-radius:9px;border:none;cursor:pointer;margin-bottom:3px;background:transparent;color:rgba(255,255,255,.5);font-weight:500;font-size:13px;font-family:'Poppins',sans-serif;transition:all .15s;text-align:left}
.nitem:hover{background:rgba(255,255,255,.07);color:rgba(255,255,255,.9)}
.nitem.active{background:rgba(16,147,217,.25);color:var(--b300);font-weight:700}
.nicon{font-size:16px;flex-shrink:0}
.sb-foot{padding:12px 10px;border-top:1px solid rgba(255,255,255,.08)}
.so-btn{color:rgba(255,255,255,.3);background:none;border:none;cursor:pointer;font-size:12px;font-family:'Poppins',sans-serif;font-weight:500}
.so-btn:hover{color:rgba(255,255,255,.7)}

.main-area{flex:1;display:flex;flex-direction:column;overflow:hidden}
.topbar{background:#fff;border-bottom:1px solid var(--b100);padding:0 28px;height:58px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0}
.tb-left{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--muted);font-weight:500}
.tb-rbtn{padding:4px 11px;border-radius:7px;border:none;cursor:pointer;font-weight:600;font-size:11px;font-family:'Poppins',sans-serif;transition:all .15s}
.tb-avatar{width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:800}
.content{flex:1;overflow-y:auto;padding:28px;background:var(--b50)}

/* ── VIEWS ── */
.ph{margin-bottom:24px}
.ptitle{font-size:24px;font-weight:800;color:var(--navy);margin-bottom:4px;letter-spacing:-.02em}
.psub{color:var(--muted);font-size:13px}
.sg{display:grid;gap:16px;margin-bottom:24px}
.sg4{grid-template-columns:repeat(4,1fr)}
.sc{background:#fff;border-radius:14px;padding:18px 20px;box-shadow:var(--shadow);border:1px solid var(--b100)}
.si{display:flex;justify-content:space-between;align-items:flex-start}
.slbl{font-size:10px;color:var(--muted);font-weight:700;letter-spacing:.07em;text-transform:uppercase;margin-bottom:7px}
.sval{font-size:26px;font-weight:800;color:var(--navy);line-height:1}
.ssub{font-size:11px;color:var(--muted);margin-top:5px}
.sico{font-size:22px;border-radius:10px;padding:9px 10px}
.tc{display:grid;gap:20px}
.c32{grid-template-columns:3fr 2fr}.c21{grid-template-columns:2fr 1fr}.c11{grid-template-columns:1fr 1fr}
.cstack{display:flex;flex-direction:column;gap:16px}
.mg{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}
.li{display:flex;align-items:center;gap:10px;padding:8px 0;cursor:pointer;border-radius:6px;transition:background .15s}
.li:hover{background:var(--b50);padding-left:6px;margin-left:-6px;padding-right:6px;margin-right:-6px}
.lchk{width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:9px;color:#fff;flex-shrink:0}

.vplayer{background:var(--navy);border-radius:14px;aspect-ratio:16/9;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;margin-bottom:14px}
.vbg{position:absolute;inset:0;background:linear-gradient(135deg,#0A2540,#094E79)}
.pbtn{width:64px;height:64px;background:rgba(255,255,255,.15);border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;backdrop-filter:blur(4px);position:relative;z-index:1;transition:all .2s;border:none}
.pbtn:hover{background:rgba(255,255,255,.28);transform:scale(1.06)}
.pbtn span{font-size:26px;color:#fff;margin-left:4px}
.vmeta{color:rgba(255,255,255,.6);font-size:12px;position:relative;z-index:1;margin-top:10px}
.vprog{position:absolute;bottom:14px;left:14px;right:14px;z-index:1}
.vbar{background:rgba(255,255,255,.18);border-radius:4px;height:4px;margin-bottom:6px}
.vbarfill{width:35%;height:100%;background:var(--b400);border-radius:4px}
.vtimes{display:flex;justify-content:space-between;color:rgba(255,255,255,.45);font-size:11px}

.tbar{display:flex;gap:4px;background:var(--b100);padding:3px;border-radius:10px;margin-bottom:16px}
.tbtn{flex:1;padding:9px 0;border-radius:7px;border:none;cursor:pointer;font-size:12px;font-family:'Poppins',sans-serif;transition:all .2s}
.tbtn.active{background:#fff;font-weight:700;color:var(--navy);box-shadow:0 1px 4px rgba(10,37,64,.1)}
.tbtn:not(.active){background:transparent;color:var(--muted);font-weight:500}

.qopt{padding:12px 14px;border-radius:9px;border:2px solid var(--b100);background:var(--b50);margin-bottom:8px;cursor:pointer;font-size:13px;font-family:'Poppins',sans-serif;color:var(--navy);transition:all .2s;font-weight:500}
.qopt:hover{border-color:var(--b400)}
.qopt.correct{border-color:var(--success);background:rgba(16,185,129,.1);color:var(--success);font-weight:700}
.qopt.wrong{border-color:var(--danger);background:rgba(239,68,68,.1);color:var(--danger);font-weight:700}

.dt{width:100%;border-collapse:collapse}
.dt th{padding:12px 16px;text-align:left;font-size:10px;font-weight:700;color:var(--muted);letter-spacing:.06em;text-transform:uppercase;background:var(--b50)}
.dt td{padding:12px 16px;border-top:1px solid var(--b100);font-size:13px}
.savatar{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:12px;flex-shrink:0}

.cms-tabs{display:flex;gap:6px;margin-bottom:20px}
.ctab{padding:9px 18px;border-radius:9px;border:none;cursor:pointer;font-size:12px;font-family:'Poppins',sans-serif;text-transform:capitalize;font-weight:600;transition:all .2s}
.sg2{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}
.ss-row{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:14px}
.ss{background:var(--b50);border-radius:8px;padding:9px;text-align:center}
.ssv{font-weight:800;font-size:16px;color:var(--navy)}.ssl{font-size:10px;color:var(--muted)}

.toggle{width:38px;height:22px;border-radius:99px;cursor:pointer;position:relative;border:none;transition:background .2s}
.tthumb{width:16px;height:16px;background:#fff;border-radius:50%;position:absolute;top:3px;transition:left .2s;box-shadow:0 1px 3px rgba(0,0,0,.2)}

.next-card{border-radius:14px;padding:20px;border:none}
.actitem{font-size:11px;color:var(--muted);margin-bottom:8px;padding-bottom:8px}
.actitem:not(:last-child){border-bottom:1px solid var(--b100)}
.back-row{display:flex;align-items:center;gap:10px;margin-bottom:18px}
.empty-st{text-align:center;padding:50px 0}
.sinput{width:100%;padding:11px 14px;border-radius:10px;border:1.5px solid var(--b100);font-size:13px;font-family:'Poppins',sans-serif;outline:none;margin-bottom:16px;background:#fff;color:var(--navy)}
.sinput:focus{border-color:var(--b400)}
.cdot{width:32px;height:32px;border-radius:50%;cursor:pointer;transition:transform .15s}
.cdot:hover{transform:scale(1.1)}
.cdot.sel{outline:3px solid var(--navy);outline-offset:2px}
.qcomplete{text-align:center;padding:20px 0}
.qscore{font-size:40px;font-weight:800}

::-webkit-scrollbar{width:5px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:var(--b200);border-radius:99px}
</style>
</head>
<body>

<!-- LANDING -->
<div id="landing" class="screen active">
  <nav class="nav">
    <a class="nav-logo" href="#"><img src="data:image/png;base64," alt="AI Surge"></a>
    <div class="nav-links">
      <a class="nav-link" onclick="document.querySelector('.features-sec').scrollIntoView({behavior:'smooth'})">How It Works</a>
      <a class="nav-link" onclick="document.querySelector('.roles-sec').scrollIntoView({behavior:'smooth'})">For Schools</a>
      <a class="nav-link" onclick="document.querySelector('.cta-sec').scrollIntoView({behavior:'smooth'})">Pricing</a>
      <button class="btn btn-primary btn-sm" onclick="showScreen('login')">Log In →</button>
    </div>
  </nav>
  <section class="hero">
    <div class="hero-dots"></div>
    <div class="hero-chip"><span>🎓 BUILT FOR SCHOOLS · NZ &amp; AUSTRALIA</span></div>
    <h1>AI Literacy for <em>Every Student</em></h1>
    <p>Short, engaging video lessons that teach students how to use AI safely, wisely and responsibly.</p>
    <div class="hero-btns">
      <button class="btn btn-primary" style="font-size:15px;padding:14px 32px" onclick="showScreen('login')">Start Free Trial →</button>
      <button class="btn btn-ghostw" style="font-size:15px;padding:14px 28px" onclick="watchDemo()">Watch Demo</button>
    </div>
    <div class="hero-stats">
      <div><div class="hstat-val">500+</div><div class="hstat-lbl">Students</div></div>
      <div><div class="hstat-val">12+</div><div class="hstat-lbl">Schools</div></div>
      <div><div class="hstat-val">40+</div><div class="hstat-lbl">Lessons</div></div>
      <div><div class="hstat-val">4.9★</div><div class="hstat-lbl">Rating</div></div>
    </div>
  </section>
  <section class="topics-sec">
    <p class="topics-lbl">What Students Learn</p>
    <div class="topics-pills">
      <span class="pill">What is AI?</span><span class="pill">Prompting Well</span><span class="pill">Bias &amp; Hallucinations</span><span class="pill">Data Privacy</span><span class="pill">Academic Integrity</span><span class="pill">Checking AI Outputs</span><span class="pill">Copyright &amp; AI</span><span class="pill">Safe School Use</span>
    </div>
  </section>
  <section class="features-sec">
    <h2>Everything your school needs</h2>
    <p class="feat-sub">One platform for students, teachers and school leaders.</p>
    <div class="feat-grid">
      <div class="feat-card"><div class="feat-icon">🎬</div><div class="feat-title">Short Video Lessons</div><div class="feat-desc">Bite-sized 2–5 minute videos students actually watch and remember.</div></div>
      <div class="feat-card"><div class="feat-icon">🧩</div><div class="feat-title">Structured Modules</div><div class="feat-desc">Organised pathways from AI basics to responsible advanced use.</div></div>
      <div class="feat-card"><div class="feat-icon">✅</div><div class="feat-title">Quizzes &amp; Reflection</div><div class="feat-desc">Knowledge checks and reflection prompts built into every lesson.</div></div>
      <div class="feat-card"><div class="feat-icon">📊</div><div class="feat-title">Teacher Dashboards</div><div class="feat-desc">Real-time class progress, completion rates and quiz performance.</div></div>
      <div class="feat-card"><div class="feat-icon">🔒</div><div class="feat-title">Privacy by Design</div><div class="feat-desc">Built for schools — minimal data, secure access, compliant architecture.</div></div>
      <div class="feat-card"><div class="feat-icon">📱</div><div class="feat-title">Works Everywhere</div><div class="feat-desc">Mobile, tablet and desktop — no app install needed, ever.</div></div>
    </div>
  </section>
  <section class="roles-sec">
    <h2>Built for Everyone in Your School</h2>
    <div class="roles-grid">
      <div class="role-card"><div class="role-icon">🎓</div><div class="role-title">Students</div><div class="role-desc">Watch lessons, take quizzes, track progress and earn completions.</div></div>
      <div class="role-card"><div class="role-icon">👩‍🏫</div><div class="role-title">Teachers</div><div class="role-desc">Assign modules, monitor progress and identify who needs support.</div></div>
      <div class="role-card"><div class="role-icon">🏫</div><div class="role-title">School Admins</div><div class="role-desc">Manage classes, upload content, view analytics and export reports.</div></div>
      <div class="role-card"><div class="role-icon">⚡</div><div class="role-title">Super Admins</div><div class="role-desc">Oversee the entire platform, all schools and content from one place.</div></div>
    </div>
  </section>
  <section class="cta-sec">
    <h2>Ready to get your school AI-literate?</h2>
    <p>Free 30-day trial. No credit card required.</p>
    <button class="btn btn-primary" style="font-size:15px;padding:14px 36px" onclick="showScreen('login')">Get Started Free →</button>
  </section>
</div>

<!-- LOGIN -->
<div id="login" class="screen">
  <div style="min-height:100vh;background:linear-gradient(135deg,var(--navy),#0D3F63);display:flex;align-items:center;justify-content:center;padding:20px">
    <div class="login-wrap">
      <div class="login-hdr">
        <img src="data:image/png;base64," alt="AI Surge">
        <p>Sign in to your learning account</p>
      </div>
      <div class="login-card">
        <div class="fgroup">
          <label class="flabel">I am a…</label>
          <div class="role-sel">
