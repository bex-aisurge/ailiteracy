          ? `<iframe src="${embedUrl}" width="100%" height="100%" frameborder="0" allow="accelerometer;autoplay;clipboard-write;encrypted-media;gyroscope;picture-in-picture" allowfullscreen style="position:absolute;inset:0;width:100%;height:100%"></iframe>`
          : `<div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;color:rgba(255,255,255,.4)">
              <div style="font-size:48px;margin-bottom:12px">🎬</div>
              <div style="font-weight:600;font-size:14px">No video added yet</div>
              <div style="font-size:12px;margin-top:4px">Paste a URL below to preview</div>
            </div>`
        }
      </div>

      <!-- URL INPUT -->
