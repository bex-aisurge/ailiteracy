// ─── EXPORT CSV ───
function exportCSV(filename='report.csv', content=''){
  if(!content){
    content='Student,Email,Progress,Quiz Avg,Modules,Last Active\n';
    content+=STUDENTS.map(s=>`${s.name},${s.email},${s.progress}%,${s.quiz}%,${s.mods}/4,${s.last}`).join('\n');
  }
  const blob=new Blob([content],{type:'text/csv'});
  const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=filename;a.click();
  toast('📊 Export downloaded!');
}

// ─── ADD QUESTION MODAL ───
function addQuizQuestion(){
  showModal('Add Quiz Question',`
    <div class="fgroup"><label class="flabel">Question</label>
      <textarea id="qq-q" class="finput" style="resize:vertical;min-height:70px" placeholder="Type your question here…"></textarea>
    </div>
    ${[0,1,2,3].map(i=>`
      <div class="fgroup" style="display:flex;gap:8px;align-items:center">
        <input type="radio" name="qq-correct" value="${i}" ${i===0?'checked':''} style="flex-shrink:0;accent-color:var(--b500)">
        <input id="qq-opt${i}" class="finput" style="flex:1;margin:0" placeholder="Option ${i+1}">
      </div>`).join('')}
    <p style="font-size:11px;color:var(--muted);margin-top:6px">☝️ Select the radio button next to the correct answer</p>`,
    ()=>{
      const q=document.getElementById('qq-q').value.trim();
      if(!q){toast('Please enter a question','#EF4444');return;}
      const opts=[0,1,2,3].map(i=>document.getElementById(`qq-opt${i}`).value||`Option ${i+1}`);
      const correct=parseInt(document.querySelector('input[name="qq-correct"]:checked').value);
      QUIZ.push({q,opts,c:correct});render();toast('✅ Question added!');
    },'Add Question');
}

// ─── EDIT QUIZ QUESTION MODAL ───
function editQuizQuestion(idx){
  const q=QUIZ[idx];
  showModal('Edit Question',`
    <div class="fgroup"><label class="flabel">Question</label>
      <textarea id="eq-q" class="finput" style="resize:vertical;min-height:70px">${q.q}</textarea>
    </div>
    ${q.opts.map((o,i)=>`
      <div class="fgroup" style="display:flex;gap:8px;align-items:center">
        <input type="radio" name="eq-correct" value="${i}" ${i===q.c?'checked':''} style="flex-shrink:0;accent-color:var(--b500)">
        <input id="eq-opt${i}" class="finput" style="flex:1;margin:0" value="${o}">
      </div>`).join('')}`,
    ()=>{
      QUIZ[idx].q=document.getElementById('eq-q').value.trim()||q.q;
      QUIZ[idx].opts=[0,1,2,3].map(i=>document.getElementById(`eq-opt${i}`).value||q.opts[i]);
      QUIZ[idx].c=parseInt(document.querySelector('input[name="eq-correct"]:checked').value);
      render();toast('✅ Question updated!');
    },'Save Changes');
}

// ─── DELETE QUIZ QUESTION ───
function deleteQuizQuestion(idx){
  showModal('Delete Question','<p style="color:var(--muted)">Are you sure you want to delete this question? This cannot be undone.</p>',
    ()=>{QUIZ.splice(idx,1);render();toast('🗑️ Question deleted','#EF4444');},'Delete','btn-danger');
}

// ─── ADD MODULE MODAL ───
function addModuleModal(){
  const colors=['#1093D9','#0474B5','#39AEF5','#055D92','#10B981','#F59E0B','#8B5CF6','#EF4444'];
  const icons=['🧠','🛡️','✍️','📚','🔬','💡','🎯','🌐'];
  showModal('New Module',`
    <div class="fgroup"><label class="flabel">Module Title</label>
      <input id="nm-title" class="finput" placeholder="e.g. AI in the Workplace"></div>
    <div class="fgroup"><label class="flabel">Icon</label>
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        ${icons.map((ic,i)=>`<button type="button" onclick="document.querySelectorAll('.icon-sel').forEach(b=>b.style.outline='none');this.style.outline='3px solid var(--b500)';document.getElementById('nm-icon').value='${ic}'" class="icon-sel" style="width:36px;height:36px;background:var(--b50);border:1px solid var(--b200);border-radius:8px;font-size:18px;cursor:pointer${i===0?';outline:3px solid var(--b500)':''}">${ic}</button>`).join('')}
        <input id="nm-icon" type="hidden" value="🧠">
      </div>
    </div>
    <div class="fgroup"><label class="flabel">Colour</label>
      <div style="display:flex;gap:8px">
        ${colors.map((c,i)=>`<div onclick="document.querySelectorAll('.col-sel').forEach(d=>d.style.outline='none');this.style.outline='3px solid var(--navy)';document.getElementById('nm-color').value='${c}'" class="col-sel" style="width:28px;height:28px;border-radius:50%;background:${c};cursor:pointer${i===0?';outline:3px solid var(--navy)':''}"></div>`).join('')}
        <input id="nm-color" type="hidden" value="#1093D9">
      </div>
    </div>`,
    ()=>{
      const title=document.getElementById('nm-title').value.trim();
      if(!title){toast('Please enter a module title','#EF4444');return;}
      const newId=MODULES.length+1;
      MODULES.push({id:newId,title,color:document.getElementById('nm-color').value,icon:document.getElementById('nm-icon').value,lessons:[]});
      render();toast('✅ Module created!');
    },'Create Module');
}

// ─── QUICK ACTIONS ───
function quickAction(label){
  if(label.includes('Add School')||label.includes('Add school'))openAddSchoolModal();
  else if(label.includes('Upload Content'))uploadContent();
  else if(label.includes('Export'))exportCSV();
  else if(label.includes('Settings'))nav('settings');
  else if(label.includes('Add Teacher'))addTeacher();
  else if(label.includes('Import Students'))importStudents();
  else if(label.includes('Assign Module'))assignModuleModal();
}

