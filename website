function previewVideo(id){
  // Re-render to pick up the new URL from the input
  const input = document.getElementById('video-url-input');
  if(input) LESSON_DATA[id].videoUrl = input.value.trim();
  render();
}

function saveLesson(id, goLive){
  const input = document.getElementById('video-url-input');
  if(input) LESSON_DATA[id].videoUrl = input.value.trim();
  if(goLive) LESSON_DATA[id].status = 'live';
  // Show toast
  const toast = document.createElement('div');
  toast.style.cssText='position:fixed;bottom:28px;left:50%;transform:translateX(-50%);background:#10B981;color:#fff;padding:12px 24px;border-radius:99px;font-weight:700;font-size:13px;font-family:Poppins,sans-serif;z-index:9999;box-shadow:0 4px 20px rgba(0,0,0,.2)';
  toast.textContent = goLive ? '🟢 Lesson saved and published!' : '💾 Saved as draft';
  document.body.appendChild(toast);
  setTimeout(()=>toast.remove(), 2500);
  editingLesson = null;
  render();
}

function addLessonToModule(moduleId){
  const m = MODULES.find(m=>m.id===moduleId);
  const newId = Math.max(...MODULES.flatMap(m=>m.lessons.map(l=>l.id))) + 1;
  const newLesson = {id:newId, title:"New Lesson", dur:"0 min", done:false};
  m.lessons.push(newLesson);
  LESSON_DATA[newId] = {title:"New Lesson", dur:"0 min", status:"draft", videoUrl:"", summary:"", moduleId};
  editLesson(newId);
}

